# Example environment file
# Copy this to .env and fill in actual values for local development

# Proxy Configuration
PORT=8080
TARGET_URL=http://localhost:3000

# Output Configuration
LOGS_DIR=logs
REPORTS_DIR=reports

# Advanced Options (optional)
# LOG_LEVEL=debug
# MASK_FIELDS=password,token,apiKey
# EXTRA_HEADERS=x-internal-key
# FILTER_PATH=/api/
# MAX_BODY_KB=256
