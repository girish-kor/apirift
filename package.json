{
  "name": "@apirift/cli",
  "version": "1.0.0",
  "description": "Deterministic API replay and drift detection engine. Captures live HTTP traffic through a transparent proxy, replays it, and detects behavioral drift.",
  "main": "src/cli.js",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "cross-env NODE_ENV=development node src/cli.js",
    "capture": "node src/cli.js capture --port 8080 --output logs/logs.jsonl",
    "replay": "node src/cli.js replay --input logs/logs.jsonl --target http://localhost:3000",
    "analyze": "node src/cli.js analyze --baseline logs/logs.jsonl --candidate logs/replay.jsonl",
    "capture:custom": "node src/cli.js capture",
    "replay:custom": "node src/cli.js replay",
    "analyze:custom": "node src/cli.js analyze",
    "clean": "node -e \"require('fs-extra').emptyDirSync('logs'); require('fs-extra').emptyDirSync('reports');\"",
    "reset": "node -e \"require('fs-extra').removeSync('logs'); require('fs-extra').removeSync('reports'); require('fs-extra').ensureDirSync('logs'); require('fs-extra').ensureDirSync('reports');\"",
    "lint": "echo \"Add eslint if needed\"",
    "test": "node test/runner.js",
    "docker:build": "docker build -t apirift .",
    "docker:run": "docker run -p 8080:8080 apirift",
    "full:flow": "npm run capture & sleep 2 && npm run replay && npm run analyze",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "api",
    "replay",
    "drift",
    "testing",
    "proxy",
    "http",
    "deterministic",
    "traffic-capture",
    "regression-testing",
    "api-testing"
  ],
  "author": "apirift",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apirift/cli.git"
  },
  "bugs": {
    "url": "https://github.com/apirift/cli/issues"
  },
  "homepage": "https://github.com/apirift/cli#readme",
  "bin": {
    "apirift": "src/cli.js"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "axios": "^1.15.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.4",
    "fs-extra": "^11.3.4",
    "http-proxy": "^1.18.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
